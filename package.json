{
  "name": "pi-workspace",
  "private": true,
  "keywords": ["pi-package"],
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./packages/bash-permission/index.ts",
      "./packages/herdr-subagent/index.ts",
      "./packages/herdr-bridge/index.ts",
      "./packages/session-auto-name/index.ts"
    ],
    "skills": ["./skills"]
  },
  "dependencies": {
    "@pi-workspace/herdr-contract": "workspace:*",
    "@pi-workspace/bash-permission": "workspace:*",
    "@pi-workspace/herdr-subagent": "workspace:*",
    "@pi-workspace/herdr-bridge": "workspace:*",
    "@pi-workspace/session-auto-name": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-tui": "0.81.1",
    "typebox": "*",
    "typescript": "^7",
    "@types/node": "^22.0.0",
    "vitest": "^3.0.0"
  }
}
