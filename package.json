{
  "name": "pi-workspace",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:fast",
    "test:fast": "pnpm exec vitest run --config vitest.fast.config.ts",
    "test:issue-loop": "node scripts/integration-lock.ts pnpm exec vitest run packages/issue-loop",
    "test:all": "node scripts/integration-lock.ts pnpm exec vitest run",
    "test:affected": "node scripts/test-affected.ts",
    "check:affected": "node scripts/test-affected.ts --check",
    "issue-loop": "node packages/issue-loop/run.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "lefthook install"
  },
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "pi": {
    "extensions": [
      "./packages/herdr-subagent/index.ts",
      "./packages/herdr-bridge/index.ts",
      "./packages/session-auto-name/index.ts",
      "./packages/code-actions/index.ts",
      "./packages/worktree-trust/index.ts",
      "./packages/ketch/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "dependencies": {
    "@pi-workspace/herdr-bridge": "workspace:*",
    "@pi-workspace/herdr-contract": "workspace:*",
    "@pi-workspace/herdr-subagent": "workspace:*",
    "@pi-workspace/ketch": "workspace:*",
    "@pi-workspace/session-auto-name": "workspace:*",
    "@pi-workspace/worktree-trust": "workspace:*",
    "@tmustier/pi-code-actions": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^22.0.0",
    "lefthook": "^2.1.10",
    "typebox": "*",
    "typescript": "^7",
    "vitest": "^3.0.0"
  }
}
