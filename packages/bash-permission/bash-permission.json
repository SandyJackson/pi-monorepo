{
  "version": 1,
  "description": "OpenCode-style bash permission policy. Global defaults are broad permissive; per-agent overrides in agents.<name>.bash tighten specialist agents. Agent tool access (whether an agent has bash at all) is defined in agent markdown frontmatter.",
  "bash": {
    "rtk *": "allow",
    "*": "allow",
    "bat *": "allow",
    "bun *": "allow",
    "cat *": "allow",
    "cd *": "allow",
    "cmake *": "allow",
    "cp *": "allow",
    "curl *": "allow",
    "cut *": "allow",
    "date": "allow",
    "diff *": "allow",
    "echo *": "allow",
    "env": "allow",
    "export *": "allow",
    "fd *": "allow",
    "file *": "allow",
    "find *": "allow",
    "gh *": "allow",
    "git *": "allow",
    "git push *": "deny",
    "git commit *": "ask",
    "grep *": "allow",
    "gzip *": "allow",
    "head *": "allow",
    "jq *": "allow",
    "ln *": "allow",
    "ls *": "allow",
    "make *": "allow",
    "man *": "allow",
    "mkdir *": "allow",
    "mv *": "allow",
    "npm *": "allow",
    "npx *": "allow",
    "pip *": "allow",
    "printenv": "allow",
    "pwd": "allow",
    "rm": "ask",
    "rm *": "ask",
    "rg *": "allow",
    "sort *": "allow",
    "tail *": "allow",
    "tar *": "allow",
    "touch *": "allow",
    "tr *": "allow",
    "tree *": "allow",
    "uniq *": "allow",
    "unzip *": "allow",
    "uv *": "allow",
    "wc *": "allow",
    "which *": "allow",
    "zip *": "allow"
  },
  "agents": {
    "code-reviewer": {
      "description": "Code review agent — only git inspection commands, matching opencode's code-reviewer permission block.",
      "bash": {
        "*": "deny",
        "git diff*": "allow",
        "git log*": "allow"
      }
    },
    "codebase-analyser": {
      "description": "Codebase analysis agent — read-only file inspection and git history commands for understanding how code works.",
      "bash": {
        "*": "deny",
        "bat *": "allow",
        "cat *": "allow",
        "cut *": "allow",
        "diff *": "allow",
        "fd *": "allow",
        "file *": "allow",
        "find *": "allow",
        "git blame *": "allow",
        "git diff *": "allow",
        "git log *": "allow",
        "git show *": "allow",
        "git status": "allow",
        "grep *": "allow",
        "head *": "allow",
        "jq *": "allow",
        "ls *": "allow",
        "man *": "allow",
        "pwd": "allow",
        "rg *": "allow",
        "sort *": "allow",
        "tail *": "allow",
        "tr *": "allow",
        "uniq *": "allow",
        "wc *": "allow",
        "which *": "allow"
      }
    },
    "docs-researcher": {
      "description": "Documentation research agent — read-only file inspection, git history, and web fetching for researching docs.",
      "bash": {
        "*": "deny",
        "bat *": "allow",
        "cat *": "allow",
        "curl *": "allow",
        "cut *": "allow",
        "diff *": "allow",
        "fd *": "allow",
        "file *": "allow",
        "find *": "allow",
        "git blame *": "allow",
        "git diff *": "allow",
        "git log *": "allow",
        "git show *": "allow",
        "git status": "allow",
        "grep *": "allow",
        "head *": "allow",
        "jq *": "allow",
        "ls *": "allow",
        "man *": "allow",
        "pwd": "allow",
        "rg *": "allow",
        "sort *": "allow",
        "tail *": "allow",
        "tr *": "allow",
        "uniq *": "allow",
        "wc *": "allow",
        "which *": "allow"
      }
    }
  }
}
